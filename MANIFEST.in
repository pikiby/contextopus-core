recursive-include src/contextopus/resources *.md *.yaml *.json
recursive-include src/contextopus/core/filtering/algorithms *.json
recursive-include examples *.py *.json *.md *.sql
recursive-include docs *.md *.svg *.png *.gif
include README.md
include CHANGELOG.md
include uv.lock
recursive-include scripts *.py
recursive-include distribution *.py *.sh *.ps1 *.md
global-exclude *.pyc *.pyo
